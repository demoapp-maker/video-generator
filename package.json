{
  "name": "rohadi-video-generator",
  "version": "0.1.0",
  "private": true,
  "description": "Pipeline produksi video pendek Rohadi: IDE -> SCRIPT -> VOICE -> HOST -> REMOTION -> SUBTITLE + BRANDING -> SHORTS",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "ideas": "node src/cli.js ideas",
    "script": "node src/cli.js script",
    "voice": "node src/cli.js voice",
    "host": "node src/cli.js host",
    "plan": "node src/cli.js plan",
    "render": "node src/cli.js render",
    "produce": "node src/cli.js produce",
    "daily": "node src/cli.js daily",
    "weekly": "node src/cli.js weekly",
    "dashboard": "node src/cli.js dashboard",
    "studio": "remotion studio remotion/index.ts",
    "browser:ensure": "node scripts/ensure-browser.mjs",
    "doctor": "node src/cli.js doctor",
    "test": "node --test tests/*.test.js",
    "ideas:md": "node src/cli.js ideas --md=content/ideas/2026-10-03.md",
    "list": "node src/cli.js list",
    "import": "node scripts/import-scripts.mjs"
  },
  "dependencies": {
    "@remotion/bundler": "^4.0.0",
    "@remotion/cli": "^4.0.0",
    "@remotion/renderer": "^4.0.0",
    "music-metadata": "^10.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "^4.0.0"
  },
  "devDependencies": {
    "@sparticuz/chromium": "^138.0.0"
  }
}

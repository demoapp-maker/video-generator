# Salin menjadi .env lalu isi sesuai kebutuhan.
# Semua variabel di bawah opsional — pipeline tetap jalan tanpanya,
# hanya saja script dan suara harus dibuat manual.

# --- Penulis script otomatis (tahap SCRIPT) ---------------------------
# Tanpa ini, `npm run script` menyusun draft dari field ide di bank ide.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# --- Suara (tahap VOICE) ----------------------------------------------
# Taruh berkas Pocket TTS secara manual di assets/audio/<id>/s1..sN
# atau pakai provider openai.
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy

# --- Host (tahap HOST) -------------------------------------------------
# Manual: simpan hasil HyperFrame di assets/host/<id>.png
# Otomatis: pakai gambar referensi di assets/host/rohadi-reference.png

# --- Render ------------------------------------------------------------
# Kalau Chromium lokal sudah diunduh, berkas ini diisi otomatis.
REMOTION_BROWSER_EXECUTABLE=
DASHBOARD_PORT=3210
